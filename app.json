{
  "expo": {
    "name": "Hobi",
    "slug": "Hobi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hobiIcon.png",
    "scheme": "hobi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/hobiIcon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.samuuuxp.Hobi"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/hobiIcon.png",
          "imageWidth": 90
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hobi necesita acceso a tus fotos para subir la evidencia de tus retos diarios.",
          "cameraPermission": "Hobi necesita acceso a tu cámara para tomar la foto de tu reto diario."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "597ddc27-21e7-46f2-a115-02a374ef8c39"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/597ddc27-21e7-46f2-a115-02a374ef8c39"
    }
  }
}
